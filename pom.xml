<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!--
        cert-manager —— 域名与 SSL 证书管理系统
        技术栈：Spring Boot 3.5 + Spring Data JPA + Thymeleaf + MySQL
        构建工具：Maven 3.9+，JDK 17+
    -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父工程，统一管理依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- 从 Maven 仓库解析父 POM -->
    </parent>

    <groupId>com.example</groupId>
    <artifactId>cert-manager</artifactId>
    <version>1.0.0</version>
    <name>cert-manager</name>
    <description>公司内部使用的域名与 SSL 证书有效期监控及签发系统</description>

    <properties>
        <!-- 使用 Java 17（Spring Boot 3.5 最低要求 17） -->
        <java.version>17</java.version>
        <!-- ACME 客户端库版本（用于 Let's Encrypt 自动签发）
             注：acme4j-utils 最高仅 2.16，主包 2.16 与 utils 2.16 配套且 API 稳定 -->
        <acme4j.version>2.16</acme4j.version>
        <!-- Hutool 工具集版本（DNS/Whois/日期等辅助） -->
        <hutool.version>5.8.32</hutool.version>
        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>

    <dependencies>
        <!-- Web 层：内嵌 Tomcat + Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据持久层：JPA + Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 模板引擎：服务端渲染页面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 参数校验：@NotBlank / @Size 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 安全框架：表单登录、密码加密（BCrypt）、路由保护、CSRF 防护 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 邮件：过期预警可选发送邮件通知 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- MySQL 驱动（运行时依赖） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok：简化 getter/setter/构造器，减少样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            ACME 客户端：acme4j 是父 POM，实际代码在子模块。
            acme4j-client 提供核心 API（Session/Account/Order/Challenge 等），
            acme4j-utils 提供密钥对、CSR、账户工具类。
        -->
        <dependency>
            <groupId>org.shredzone.acme4j</groupId>
            <artifactId>acme4j-client</artifactId>
            <version>${acme4j.version}</version>
        </dependency>
        <!-- ACME 辅助工具：密钥对生成、CSR 构建等 -->
        <dependency>
            <groupId>org.shredzone.acme4j</groupId>
            <artifactId>acme4j-utils</artifactId>
            <version>${acme4j.version}</version>
        </dependency>

        <!-- Hutool 工具集：Whois 查询、集合/日期处理等 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- 使用内置 Public Suffix List 正确识别 .com.cn 等多级公共后缀 -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.8-jre</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cert-manager</finalName>
        <plugins>
            <!-- Spring Boot 打包插件：生成可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok 仅编译期使用，排除出最终依赖清单 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
